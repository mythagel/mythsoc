LOCATE COMP "sd_dq_io[8]"  SITE "E7";
LOCATE COMP "sd_dq_io[9]"  SITE "C6";
LOCATE COMP "sd_dq_io[10]" SITE "D7";
LOCATE COMP "sd_dq_io[11]" SITE "D6";
LOCATE COMP "sd_dq_io[12]" SITE "E6";
LOCATE COMP "sd_dq_io[13]" SITE "D5";
LOCATE COMP "sd_dq_io[14]" SITE "C5";
LOCATE COMP "sd_dq_io[15]" SITE "E5";
LOCATE COMP "sd_dq_io[16]" SITE "A11";
LOCATE COMP "sd_dq_io[17]" SITE "B11";
LOCATE COMP "sd_dq_io[18]" SITE "B12";
LOCATE COMP "sd_dq_io[19]" SITE "A13";
LOCATE COMP "sd_dq_io[20]" SITE "B13";
LOCATE COMP "sd_dq_io[21]" SITE "A14";
LOCATE COMP "sd_dq_io[22]" SITE "B14";
LOCATE COMP "sd_dq_io[23]" SITE "D14";
LOCATE COMP "sd_dq_io[24]" SITE "D13";
LOCATE COMP "sd_dq_io[25]" SITE "E11";
LOCATE COMP "sd_dq_io[26]" SITE "C13";
LOCATE COMP "sd_dq_io[27]" SITE "D11";
LOCATE COMP "sd_dq_io[28]" SITE "C12";
LOCATE COMP "sd_dq_io[29]" SITE "E10";
LOCATE COMP "sd_dq_io[30]" SITE "C11";
LOCATE COMP "sd_dq_io[31]" SITE "D10";
IOBUF PORT "sd_clk_o" IO_TYPE=LVCMOS33;
IOBUF PORT "sd_ras_n_o" IO_TYPE=LVCMOS33;
IOBUF PORT "sd_cas_n_o" IO_TYPE=LVCMOS33;
IOBUF PORT "sd_we_n_o" IO_TYPE=LVCMOS33;
IOBUF PORT "sd_ba_o[0]" IO_TYPE=LVCMOS33;
IOBUF PORT "sd_ba_o[1]" IO_TYPE=LVCMOS33;
IOBUF PORT "sd_a_o[0]" IO_TYPE=LVCMOS33;
IOBUF PORT "sd_a_o[1]" IO_TYPE=LVCMOS33;
